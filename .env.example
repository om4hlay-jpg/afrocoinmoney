# Copy this file to .env and fill in your real values.

# Server port
PORT=3000

# Public base URL used for WolvPay payment redirects (no trailing slash).
APP_PUBLIC_URL=http://localhost:3000

# Secret used to sign login tokens. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# PostgreSQL connection (local VPS database).
# The app creates its own tables on boot (lib/schema.js) and seeds the
# investment levels + tasks (seed.js), so no manual SQL is required.
DATABASE_URL=postgresql://afrocoinmoney:your-password@localhost:5432/afrocoinmoney

# Set to true for managed/cloud databases that require SSL (Supabase, Neon, etc.).
DATABASE_SSL=false

# WolvPay (crypto payment processor) - https://wolvpay.com/docs
WOLVPAY_API_KEY=wlov_<your-api-key>
WOLVPAY_WEBHOOK_SECRET=<your-webhook-signing-secret>
# WOLVPAY_BASE_URL=https://wolvpay.com/api/v1
#
# WOLVPAY_ENABLED_COINS - comma-separated WolvPay coin identifiers this
# merchant can actually receive (e.g. btc,eth,trc20_usdt). Only these appear
# in the deposit picker and are accepted on deposit. Omit to offer every coin
# WolvPay supports.
WOLVPAY_ENABLED_COINS=

# Money rules
MIN_DEPOSIT_USD=10
MIN_WITHDRAW_USD=30
WITHDRAW_FEE_PERCENT=10

# Login bot prevention + brute-force protection (lib/authGuard.js)
GUARD_IP_WINDOW_MS=600000
GUARD_IP_MAX_ATTEMPTS=25
GUARD_MAX_FAILS=5
GUARD_LOCK_MS=900000
GUARD_FAIL_RESET_MS=900000
GUARD_CHALLENGE_TTL_MS=120000
GUARD_POW_BITS=16

# Legacy migration only (old UGX-era databases).
LEGACY_UGX_PER_USD=3700

# Platform administrator credentials (optional).
# Set these before first boot to seed a single initial admin account.
ADMIN_EMAIL=admin@afrocoinmoney.com
ADMIN_PASSWORD=change-me-on-first-login
