# afrocoinmoney production environment settings.

# Server port
PORT=3000

# Public base URL used for WolvPay payment redirects (no trailing slash).
APP_PUBLIC_URL=http://localhost:3000

# Secret used to sign login tokens. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# PostgreSQL connection (local VPS database).
DATABASE_URL=postgresql://afrocoinmoney:AfroCoinMoney123@localhost:5432/afrocoinmoney

# Set to true for managed/cloud databases that require SSL (Supabase, Neon, etc.).
DATABASE_SSL=false

# WolvPay (crypto payment processor) - https://wolvpay.com/docs
WOLVPAY_API_KEY=wlov_live_95fad07e941948a646a7bf2d8f58e3cc
WOLVPAY_WEBHOOK_SECRET=ad2e312730bd29afb6e043f0237e01a02031d74223d9cb2273050124bf04d158
# WOLVPAY_BASE_URL=https://wolvpay.com/api/v1
WOLVPAY_ENABLED_COINS=btc,eth,erc20_usdc,sol_usdc,erc20_usdt,sol_usdt,trc20_usdt

# Money rules
MIN_DEPOSIT_USD=10
MIN_WITHDRAW_USD=30
WITHDRAW_FEE_PERCENT=10

# Legacy migration only (old UGX-era databases).
LEGACY_UGX_PER_USD=3700

# Platform administrator credentials (seeded on first boot).
ADMIN_EMAIL=admin@afrocoinmoney.com
ADMIN_PASSWORD=change-me-on-first-login
